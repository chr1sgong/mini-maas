{
  "uid": "maas-overview",
  "title": "MaaS / Overview",
  "tags": ["maas"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    { "id": 1, "type": "row", "title": "Traffic", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [], "collapsed": false },
    {
      "id": 2, "type": "timeseries", "title": "Gateway RPS by model",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (model) (rate(maas_gateway_requests_total[1m]))", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "429 rate by tenant / dimension",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (tenant, dimension) (rate(maas_gateway_ratelimit_rejected_total[1m]))", "legendFormat": "{{tenant}} / {{dimension}}" }
      ]
    },
    { "id": 4, "type": "row", "title": "Latency（网关与引擎并排，差值 = 网关+网络开销）", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }, "panels": [], "collapsed": false },
    {
      "id": 5, "type": "timeseries", "title": "TTFT P50/P99 — gateway vs vLLM",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le, model) (rate(maas_gateway_ttft_seconds_bucket[1m])))", "legendFormat": "gw P50 {{model}}" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le, model) (rate(maas_gateway_ttft_seconds_bucket[1m])))", "legendFormat": "gw P99 {{model}}" },
        { "refId": "C", "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))", "legendFormat": "vllm P50" },
        { "refId": "D", "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))", "legendFormat": "vllm P99" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "TPOT P50/P99 — gateway vs vLLM",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le, model) (rate(maas_gateway_tpot_seconds_bucket[1m])))", "legendFormat": "gw P50 {{model}}" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le, model) (rate(maas_gateway_tpot_seconds_bucket[1m])))", "legendFormat": "gw P99 {{model}}" },
        { "refId": "C", "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_per_output_token_seconds_bucket[1m])))", "legendFormat": "vllm P50" },
        { "refId": "D", "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_per_output_token_seconds_bucket[1m])))", "legendFormat": "vllm P99" }
      ]
    },
    { "id": 7, "type": "row", "title": "Throughput", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }, "panels": [], "collapsed": false },
    {
      "id": 8, "type": "timeseries", "title": "Generation tok/s by instance",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (rate(vllm:generation_tokens_total[1m]))", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Prompt tok/s by instance",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (rate(vllm:prompt_tokens_total[1m]))", "legendFormat": "{{instance}}" }
      ]
    },
    { "id": 10, "type": "row", "title": "Routing", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }, "panels": [], "collapsed": false },
    {
      "id": 11, "type": "timeseries", "title": "Route decisions by endpoint",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 25 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (endpoint) (rate(maas_gateway_route_decisions_total[1m]))", "legendFormat": "{{endpoint}}" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Prefix-affinity hit ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(maas_gateway_route_decisions_total{reason=\"affinity\"}[5m])) / (sum(rate(maas_gateway_route_decisions_total{reason=\"affinity\"}[5m])) + sum(rate(maas_gateway_route_decisions_total{reason=\"affinity-fallback\"}[5m])))", "legendFormat": "hit ratio" }
      ]
    },
    { "id": 13, "type": "row", "title": "Saturation（容量信号在这里，不在 GPU util）", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "panels": [], "collapsed": false },
    {
      "id": 14, "type": "timeseries", "title": "vLLM running / waiting by instance",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "vllm:num_requests_running", "legendFormat": "running {{instance}}" },
        { "refId": "B", "expr": "vllm:num_requests_waiting", "legendFormat": "waiting {{instance}}" }
      ]
    },
    {
      "id": 15, "type": "timeseries", "title": "KV cache usage by instance",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "vllm:kv_cache_usage_perc", "legendFormat": "{{instance}}" }
      ]
    },
    { "id": 16, "type": "row", "title": "GPU（多模型共卡干扰与成本视角；连续批处理下 util 只读得出 0 或 ~100%）", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }, "panels": [], "collapsed": false },
    {
      "id": 17, "type": "timeseries", "title": "GPU utilization",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}" }
      ]
    },
    {
      "id": 18, "type": "timeseries", "title": "Framebuffer used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "mbytes", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "GPU {{gpu}}" }
      ]
    }
  ]
}