{
  "listen": ":8080",
  "metering": true,
  "defaults": { "max_tokens": 1024 },
  "routing": {
    "strategy": "prefix_affinity",
    "affinity_bytes": 256,
    "max_affinity_inflight": 8
  },
  "keys": [
    {
      "key": "sk-tenant-a-EXAMPLE",
      "tenant": "tenant-a",
      "models": ["qwen2.5-7b-awq"],
      "quota": { "qps": 64, "qps_burst": 64, "tpm": 200000 }
    },
    {
      "key": "sk-tenant-b-EXAMPLE",
      "tenant": "tenant-b",
      "models": ["qwen2.5-3b"],
      "quota": { "qps": 5, "qps_burst": 5, "tpm": 20000 }
    }
  ]
}
